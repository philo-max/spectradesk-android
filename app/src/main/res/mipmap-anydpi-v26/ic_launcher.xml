<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: the artwork is three colour samples joined into a triangle,
     which reads as the delta in "delta E" - the colour difference this app
     measures.  The foreground is a PNG (not a vector) because the artwork is
     drawn by branding/generate_icons.py so the launcher icon, the store listing
     and any printed material come from one source. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
